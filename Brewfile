# Install everything with: brew bundle --file ~/workspaces/dotfiles/Brewfile

# Core CLI
brew "git"
brew "gh"          # GitHub CLI
brew "wget"
brew "jq"

# Runtime / version management
brew "mise"        # Node, Python, etc. versions (global + per-project)
brew "uv"          # fast Python packages, venvs, and tools
brew "direnv"      # auto-load devenv / project envs on cd

# Nicer shell
brew "fzf"         # fuzzy Ctrl-R history, Ctrl-T files, Alt-C cd
brew "eza"         # modern ls (maintained replacement for exa)
brew "ripgrep"     # rg: fast grep
brew "fd"          # fast find
brew "bat"         # cat with syntax highlighting

# Mobile
brew "cocoapods"   # iOS native deps; Expo `run:ios` runs pod install
brew "xcodes"      # install/switch Xcode versions from the CLI (Apple ID login)

# Apps
cask "visual-studio-code"
cask "orbstack"    # Docker engine + CLI
